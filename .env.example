# ===================================================
# VERTEX QUOTE AUTOMATION SYSTEM - ENVIRONMENT CONFIG EXAMPLE
# ===================================================

# 1. General App Settings
APP_NAME="Vertex Quote Automation"
APP_ENV="development"
DEBUG=True
HOST="0.0.0.0"
PORT=8000
BASE_URL="http://localhost:8000"
SECRET_KEY="your-secure-secret-key-min-32-chars"
ALLOW_UNSIGNED_WEBHOOK=false

# 2. Company Information
COMPANY_NAME="CÔNG TY CỔ PHẦN CÔNG NGHỆ VẬT TƯ VERTEX"
COMPANY_BRAND="VERTEX HVAC & MEP SOLUTIONS"
COMPANY_HOTLINE="0988.123.456"
COMPANY_EMAIL="contact@vertexhvac.vn"
COMPANY_WEBSITE="https://vertexhvac.vn"
COMPANY_ADDRESS="Khu Công Nghiệp Quang Minh, Mê Linh, Hà Nội"
COMPANY_BANK_INFO="STK: 190368686868 - Techcombank CN Hà Nội - CTCP Công Nghệ Vật Tư Vertex"

# 3. Default Pricing & Tax Settings
DEFAULT_VAT_RATE=0.08          # 8% VAT (or 0.10 for 10%)
DEFAULT_DISCOUNT_RATE=0.05     # 5% chiết khấu mặc định
QUOTE_CODE_PREFIX="VTX"
QUOTE_VALIDITY_DAYS=15         # Báo giá có hiệu lực trong 15 ngày

# 4. AI Provider Settings (Groq API - OpenAI Compatible)
AI_PROVIDER="groq"
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL_NAME="llama-3.3-70b-versatile"
AI_API_KEY="gsk_your_groq_api_key_here"

# 5. Zalo Official Account (Zalo OA) Integration
ZALO_OA_ENABLED=True
ZALO_OA_ID="1234567890123456789"
ZALO_APP_ID="987654321098765432"
ZALO_SECRET_KEY="your_zalo_app_secret_key"
ZALO_OA_ACCESS_TOKEN="your_zalo_oa_access_token"
ZALO_OA_REFRESH_TOKEN="your_zalo_oa_refresh_token"
ZALO_WEBHOOK_SECRET="your_zalo_webhook_secret_key"

# Danh sách Zalo User ID của người quản lý duyệt báo giá
MANAGER_ZALO_USER_IDS="viet_manager_zalo_id_001,tien_boss_zalo_id_002"
MANAGER_NAMES="Anh Việt (Trưởng phòng KD), Sếp Tiến (Giám đốc)"

# 6. Storage Paths
STORAGE_DIR="storage"
UPLOAD_DIR="storage/uploads"
QUOTES_DIR="storage/quotes"
